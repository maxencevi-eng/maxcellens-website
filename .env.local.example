# Copy this file to `.env.local` and fill the values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Galeries clients — stockage Cloudflare R2 (bucket privé) et secret de signature.
# Voir docs/GALERIES-CLIENTS-2026.md § Mise en service.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=maxcellens-galeries
# GALLERY_SECRET=   (32+ caractères aléatoires)

# Optionnel : secret pour la purge cron des analytics (> 3 mois).
# Définir CRON_SECRET en prod (Vercel) puis appeler GET/POST /api/admin/analytics/purge avec ?secret=CRON_SECRET ou header X-Cron-Secret.
# CRON_SECRET=

# SUPABASE_SERVICE_ROLE_KEY=

# Comptes Supabase autorisés à administrer le site (séparés par des virgules).
# ADMIN_EMAILS=maxcellens@gmail.com

# Bureau à la carte : secret de signature des sessions (obligatoire) et mot de passe admin.
# BAC_SESSION_SECRET=   (32+ caractères aléatoires)
# BAC_ADMIN_PASSWORD=

# E-mails (formulaire de contact, notifications des galeries) via Brevo.
# MAIL_FROM doit être un expéditeur validé dans Brevo (domaine maxcellens.com authentifié).
# BREVO_API_KEY=
# MAIL_FROM=Maxcellens <site@maxcellens.com>
# NOTIFY_EMAIL=maxcellens@gmail.com
