# Copy this file to `.env.local` and fill the values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Galeries clients — stockage Cloudflare R2 (bucket privé) et secret de signature.
# Voir docs/GALERIES-CLIENTS-2026.md § Mise en service.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=maxcellens-galeries
# GALLERY_SECRET=   (32+ caractères aléatoires)

# Optionnel : secret pour la purge cron des analytics (> 3 mois).
# Définir CRON_SECRET en prod (Vercel) puis appeler GET/POST /api/admin/analytics/purge avec ?secret=CRON_SECRET ou header X-Cron-Secret.
# CRON_SECRET=

# Galeries clients — notifications e-mail (review vidéo terminée), via Resend
# RESEND_API_KEY=
# NOTIFY_EMAIL=
# MAIL_FROM=   (facultatif, après validation du domaine dans Resend)
